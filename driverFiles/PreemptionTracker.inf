;
; PreemptionTracker.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = PreemptionTracker.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
PreemptionTracker.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%PreemptionTracker.DeviceDesc% = PreemptionTracker_Device, Root\PreemptionTracker ; TODO: edit hw-id

[PreemptionTracker_Device.NT]
CopyFiles = File_Copy

[File_Copy]
PreemptionTracker.sys

;-------------- Service installation
[PreemptionTracker_Device.NT.Services]
AddService = PreemptionTracker,%SPSVCINST_ASSOCSERVICE%, PreemptionTracker_Service_Inst

; -------------- PreemptionTracker driver install sections
[PreemptionTracker_Service_Inst]
DisplayName    = %PreemptionTracker.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\PreemptionTracker.sys

[PreemptionTracker_Device.NT.Wdf]
KmdfService = PreemptionTracker, PreemptionTracker_wdfsect

[PreemptionTracker_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "PreemptionTracker Installation Disk"
PreemptionTracker.DeviceDesc = "PreemptionTracker Device"
PreemptionTracker.SVCDESC = "PreemptionTracker Service"
